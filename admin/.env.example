PORT=8787
# Login password for the admin UI
ADMIN_PASSWORD=change-me
# Random string; encrypts provider API keys at rest and signs session cookies
ADMIN_SECRET=change-me-too-long-random-string

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/calcode_admin

S3_BUCKET=company-calcode-audit
S3_REGION=us-east-1
S3_PREFIX=calcode-audit/
# Explicit S3 credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY also work;
# leave all unset to use the AWS profile / instance role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Optional: MinIO / LocalStack
# S3_ENDPOINT=http://localhost:9000

# Tests only: a disposable database whose admin tables may be dropped
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/calcode_admin_test
